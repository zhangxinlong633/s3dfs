# S3 API / 控制台
S3DFS_API_PORT=9000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9000
S3DFS_ACCESS_KEY=
S3DFS_SECRET_KEY=

# 独立的 dleveldb 索引集群（建议 3–5 台，不要和大量 block 机器绑在一起）
S3DFS_INDEX_URLS=http://127.0.0.1:9800

# block 存储节点：nodeId=host:port，逗号分隔。机器可以很多。
# 单机开发默认一台；多副本时再加 block2=127.0.0.1:9101 等。
S3DFS_BLOCK_NODES=block1=127.0.0.1:9100
S3DFS_DATA_REPLICAS=3
S3DFS_HEALTH_INTERVAL_MS=5000

# 单个 block 进程自身
S3DFS_BLOCK_NODE_ID=block1
S3DFS_BLOCK_PORT=9100
S3DFS_ADVERTISE_ADDR=127.0.0.1:9100
S3DFS_DATA_DIR=./data/block
S3DFS_BLOCK_SIZE=1073741824
S3DFS_BUFFER_SIZE=1048576
S3DFS_FLUSH_INTERVAL_MS=50
