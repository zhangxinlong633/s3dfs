# 数据目录、本机身份与监听地址
DLEVELDB_DATA_DIR=./data
DLEVELDB_NODE_ID=node1
DLEVELDB_PORT=9000
DLEVELDB_ADVERTISE_ADDR=127.0.0.1:9000

# 加入已有集群时填写种子节点，逗号分隔
# DLEVELDB_PEERS=127.0.0.1:9000

# 分片与副本
DLEVELDB_VNODES=4
DLEVELDB_REPLICAS=3
# 不设则取有效副本数的多数
# DLEVELDB_WRITE_QUORUM=2

# 写入是否同步落盘
DLEVELDB_SYNC=true

# Chord 与 RPC
# DLEVELDB_STABILIZE_INTERVAL_MS=500
# DLEVELDB_RPC_TIMEOUT_MS=10000

# 控制台指向的 API
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9000
