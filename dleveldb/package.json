{
  "name": "dleveldb-workspace",
  "private": true,
  "description": "Distributed LevelDB workspace: core KV, Nest API, and Next.js console",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=9.0.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @dleveldb/api dev",
    "dev:web": "pnpm --filter @dleveldb/web dev",
    "build": "pnpm --filter dleveldb build && pnpm --filter @dleveldb/api build && pnpm --filter @dleveldb/web build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist .next node_modules/.cache",
    "start": "pnpm --filter dleveldb start",
    "test": "pnpm --filter dleveldb test",
    "test:chord": "pnpm --filter dleveldb test:chord",
    "test:shards": "pnpm --filter dleveldb test:shards",
    "test:replicas": "pnpm --filter dleveldb test:replicas",
    "bench": "pnpm --filter dleveldb bench"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangxinlong633/dleveldb.git"
  },
  "license": "MIT"
}
